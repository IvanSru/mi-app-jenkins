# ── Servidor ─────────────────────────────────────────────────
PORT=3000

# ── Base de datos ─────────────────────────────────────────────
# MongoDB debe estar corriendo localmente (mongod)
MONGODB_URI=mongodb://localhost:27017/blade-barberia

# ── JWT ───────────────────────────────────────────────────────
# Cambia este valor por uno aleatorio y seguro
JWT_SECRET=cambia_este_secreto_por_uno_seguro_en_produccion
JWT_EXPIRES_IN=7d

# ── Firebase FCM (push notifications) ─────────────────────────
# Obtén estas credenciales en: Firebase Console > Configuración del proyecto > Cuentas de servicio
# Si no las configuras, las notificaciones push quedan deshabilitadas (el resto funciona igual)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
